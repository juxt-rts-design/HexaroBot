NODE_ENV=development
PORT=5010

# Supabase
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email promu admin automatiquement au premier /api/auth/me
ADMIN_EMAIL=

# WhatsApp companion (phase ultérieure)
COHERE_API_KEY=
WITAI_API_KEY=

FRONTEND_URL=http://localhost:5011

# API Hexaro downloader (Instagram, YouTube, Facebook, X, Pinterest…)
# TikTok utilise tikwm en local ; le reste passe par cette API.
DOWNLOADER_API_URL=
SITE_DOWNLOADER_LOCAL_FALLBACK=false

# DarePay / HexaPay (Airtel Money + MoBiCash)
DAREPAY_API_KEY=
DAREPAY_BASE_URL=https://darepay.devetu.org/api
SUBSCRIPTION_PRICE_XAF=2100
TRIAL_DAYS=3
# URL publique HTTPS du backend (prod: https://chat.92-222-80-91.sslip.io)
# À donner à l'admin DarePay comme callback :
#   ${PUBLIC_BASE_URL}/api/hexapay/callback
PUBLIC_BASE_URL=https://chat.92-222-80-91.sslip.io
